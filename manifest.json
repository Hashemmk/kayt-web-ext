{
  "manifest_version": 3,
  "name": "Kayt — timestamped notes for YouTube",
  "short_name": "Kayt",
  "version": "1.3.0",
  "description": "Take timestamped notes on YouTube without pausing. Press Alt+N, type, press Enter. Notes stay in your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "tabCapture", "offscreen"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kayt: your notes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "open-capture": {
      "suggested_key": { "default": "Alt+N" },
      "description": "Add a note at the current moment of the video"
    },
    "toggle-range": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Start a range, or end it and save it"
    },
    "voice-note": {
      "suggested_key": { "default": "Alt+V" },
      "description": "Add a voice note at the current moment"
    },
    "toggle-listening": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Turn listening to the video on or off (Snips and range transcripts)"
    },
    "snip": {
      "description": "Snip: save what the video said around this moment"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/capture.css", "lib/youtube-url.js", "lib/storage.js"],
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]
    }
  ]
}
